  "directions": [
    "down",
    "up",
    "left",
    "right"
  ],
  "layouts": {
    "monster": {
      "label": "Monster sheet (16x16, 4 directions x 4 walk frames)",
      "frameWidth": 16,
      "frameHeight": 16,
      "anchor": [
        0.5,
        1
      ],
      "anims": {
        "idle": {
          "dirs": true,
          "start": [
            0,
            0
          ],
          "frames": 4,
          "fps": 3,
          "loop": true
        },
        "walk": {
          "dirs": true,
          "start": [
            0,
            0
          ],
          "frames": 4,
          "fps": 8,
          "loop": true
        }
      }
    },
    "hero": {
      "label": "Fully animated character (32x32 frames, separate files per animation)",
      "frameWidth": 32,
      "frameHeight": 32,
      "anchor": [
        0.5,
        0.75
      ],
      "anims": {
        "idle": {
          "file": "Separate/Idle.png",
          "dirs": true,
          "start": [
            0,
            0
          ],
          "frames": 4,
          "fps": 4,
          "loop": true
        },
        "walk": {
          "file": "Separate/Walk.png",
          "dirs": true,
          "start": [
            0,
            0
          ],
          "frames": 4,
          "fps": 8,
          "loop": true
        },
        "swing": {
          "file": "Separate/Attack.png",
          "dirs": true,
          "start": [
            0,
            0
          ],
          "frames": 4,
          "fps": 10,
          "loop": true
        },
        "pickup": {
          "file": "Separate/Pickup.png",
          "dirs": false,
          "axis": "col",
          "start": [
            0,
            0
          ],
          "frames": 2,
          "fps": 4,
          "loop": true
        },
        "item": {
          "file": "Separate/Item.png",
          "dirs": false,
          "axis": "col",
          "start": [
            0,
            0
          ],
          "frames": 2,
          "fps": 4,
          "loop": true
        }
      }
    },
    "character": {
      "label": "Simple character sheet (16x16, 4 directions; walk, swing, jump rows)",
      "frameWidth": 16,
      "frameHeight": 16,
      "anchor": [
        0.5,
        1
      ],
      "anims": {
        "idle": {
          "dirs": true,
          "start": [
            0,
            0
          ],
          "frames": 1,
          "fps": 1,
          "loop": true
        },
        "walk": {
          "dirs": true,
          "start": [
            0,
            0
          ],
          "frames": 4,
          "fps": 8,
          "loop": true
        },
        "swing": {
          "dirs": true,
          "start": [
            0,
            3
          ],
          "frames": 2,
          "fps": 4,
          "loop": true
        }
      }
    },
    "strip": {
      "label": "One row of frames (boss idle strips); frame size set per role",
      "frameWidth": 16,
      "frameHeight": 16,
      "anchor": [
        0.5,
        1
      ],
      "anims": {
        "idle": {
          "dirs": false,
          "axis": "row",
          "start": [
            0,
            0
          ],
          "frames": 0,
          "fps": 6,
          "loop": true
        }
      }
    },
    "icon": {
      "label": "Item icon (one picture up to 16x16, centred in a 16x16 cell)",
      "frameWidth": 16,
      "frameHeight": 16,
      "anchor": [
        0.5,
        0.5
      ],
      "pad": true,
      "single": true,
      "anims": {
        "idle": {
          "dirs": false,
          "start": [
            0,
            0
          ],
          "frames": 1,
          "fps": 1,
          "loop": true
        }
      }
    },
    "held": {
      "label": "Held tool (one picture; the anchor is the grip)",
      "frameWidth": 16,
      "frameHeight": 16,
      "anchor": [
        0.15,
        0.85
      ],
      "single": true,
      "anims": {
        "idle": {
          "dirs": false,
          "start": [
            0,
            0
          ],
          "frames": 1,
          "fps": 1,
          "loop": true
        }
      }
    },
    "prop": {
      "label": "Scene prop (one picture, anchored at its bottom centre)",
      "frameWidth": 16,
      "frameHeight": 16,
      "anchor": [
        0.5,
        1
      ],
      "single": true,
      "anims": {
        "idle": {
          "dirs": false,
          "start": [
            0,
            0
          ],
          "frames": 1,
          "fps": 1,
          "loop": true
        }
      }
    }
